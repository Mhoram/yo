# Copy to deploy/backup.env (gitignored) on the machine running the cron job.
# Full setup walkthrough: deploy/self-host.md §8a–8c.

# --- AWS S3 (preferred) ---
# A small private bucket with **versioning enabled** (gives point-in-time
# history with no extra retention logic).
#
# Credentials: store the scoped yo-backup key under a named profile
# (`aws configure --profile yo-backup` — see self-host.md §8b/8c) and export
# the profile here. The `export` is required — only exported variables reach
# the `aws` subprocess. If you'd rather use the machine's default profile,
# delete the line entirely.
export AWS_PROFILE=yo-backup
BACKUP_S3_BUCKET=mhoram-yo-db-backups
BACKUP_S3_REGION=eu-west-1

# --- rclone alternative (if avoiding AWS entirely, e.g. Backblaze B2) ---
# BACKUP_RCLONE_REMOTE=b2:yo-db-backups

# --- Optional overrides (defaults shown) ---
# YO_DIR=/home/mhoram/yo
# YO_SERVICE=yo
# YO_DB_FILENAME=yo.db
# BACKUP_DIR=/tmp/yo-backups
